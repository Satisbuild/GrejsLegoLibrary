# Kopiér til backend/.env og udfyld. backend/.env må ALDRIG committes.

PORT=3000
NODE_ENV=development

# MongoDB-forbindelse (kun på serveren). Brug en adgangskode, der IKKE har været delt.
MONGODB_URI=mongodb://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/GrejsLegoLibrary?directConnection=true

# Lang tilfældig streng (mindst 32 tegn), fx: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret

# Frontend-domæne(r), der må kalde API'et – kommasepareret, uden afsluttende skråstreg.
FRONTEND_ORIGIN=http://localhost:3000

# LEGO-katalog: Rebrickable API-nøgle (gratis: https://rebrickable.com/api/). Tom = kun manuel indtastning.
LEGO_CATALOG_PROVIDER=rebrickable
LEGO_CATALOG_API_KEY=replace_with_api_key_if_required
# Hvor mange dage cachede sætoplysninger er gyldige, før de hentes igen.
CATALOG_CACHE_TTL_DAYS=30

# Cookies: lax når frontend og API deler domæne (fx grejslego.dk + api.grejslego.dk).
# none kun hvis de ligger på HELT forskellige domæner (kræver HTTPS og COOKIE_SECURE=true).
COOKIE_SAMESITE=lax
# true i produktion (HTTPS). Standard: true når NODE_ENV=production.
COOKIE_SECURE=false

# Sæt til 1, når backend kører bag én reverse proxy (nginx/Caddy).
TRUST_PROXY=

# true = backend serverer også ../frontend (praktisk lokalt).
SERVE_FRONTEND=true

SESSION_MAX_AGE_DAYS=14
