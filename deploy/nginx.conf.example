# Eksempel: nginx som HTTPS reverse proxy foran backend (certifikat fx via certbot).
server {
    listen 443 ssl http2;
    server_name api.grejslego.dk;

    ssl_certificate     /etc/letsencrypt/live/api.grejslego.dk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.grejslego.dk/privkey.pem;

    client_max_body_size 100k;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name api.grejslego.dk;
    return 301 https://$host$request_uri;
}
