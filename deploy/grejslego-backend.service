# systemd-service til backend. Kopiér til /etc/systemd/system/ og tilpas stierne.
#   sudo systemctl daemon-reload && sudo systemctl enable --now grejslego-backend
[Unit]
Description=GrejsLegoLibrary API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grejslego
WorkingDirectory=/opt/GrejsLegoLibrary/backend
# Miljøvariabler (inkl. MONGODB_URI) ligger KUN her på serveren – chmod 600, ejet af grejslego.
EnvironmentFile=/etc/grejslego/backend.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
